# Non-secret deployment configuration read by cloudflare.config.ts
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-aud-tag
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_HOSTNAMES=game.example.com
INSTANCE_ADMIN_EMAIL=admin@example.com

# Store TURNSTILE_SECRET with Cloudflare's secret manager, never in this file.

